# =====================================
# Ignore top-level folders
# =====================================

.agents/
.clinerules/
.continue/
Launcher/
Venvs/

# =====================================
# Python
# =====================================

**/__pycache__/
*.pyc
*.pyo
*.pyd

# =====================================
# Node
# =====================================

**/node_modules/

# =====================================
# Build outputs
# =====================================

**/dist/
**/build/
**/out/

# =====================================
# Environment files
# =====================================

.env
.env.*
*.env
!.env.example

# =====================================
# Secrets
# =====================================

*.key
*.pem
credentials.json
api_keys.json
secrets.json

# =====================================
# Windows
# =====================================

Thumbs.db
Desktop.ini

# =====================================
# Temporary files
# =====================================

*.log
.cache/
temp/
tmp/

# =====================================
# Ignore inspection files
# =====================================

status.txt
git-status.txt
ai_studio_overview.txt


# =====================================
# Models
# =====================================

# Ignore everything in Models
Models/*

# Allow F5-TTS folder itself
!Models/F5-TTS/

# Ignore everything inside F5-TTS
Models/F5-TTS/*

# Allow only ref_voices
!Models/F5-TTS/ref_voices/

# Track everything inside ref_voices
!Models/F5-TTS/ref_voices/**

# Explicitly ignore remaining F5-TTS folders
Models/F5-TTS/hub/
Models/F5-TTS/xet/
Models/F5-TTS/.agent_harnesses.json

# Ignore other model folders entirely
Models/blobs/
Models/Kokoro/
Models/manifests/
Models/metadata/

